# Local conflict/duplicate copies: preserve on disk, but keep import staging
# allowlists and production commits from treating them as catalog artifacts.
/LOGO 2.png
/data/history/* 2.json
/data/meta/* 2.json
/data/snapshots/steam/* 2.json
/data/snapshots/eshop/* 2.json

# Legacy/fallback runtime locks beside the tracked PSN audit mirror. Normal
# local/import locking lives under already-ignored /private/runtime so every
# linked worktree on this machine shares one authoritative allowance.
/data/seeds/psn-us-request-budget.json.lock
/data/seeds/psn-us-request-budget.json.run.lock
/data/seeds/psn-us-request-budget.json.*.tmp
