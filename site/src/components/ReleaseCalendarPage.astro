---
import Layout from '../layouts/Layout.astro';
import { calendar, gameBundle } from '../lib/data.mjs';

interface Props { month: string; canonicalPath?: string | null }
const { month, canonicalPath = null } = Astro.props;
const cal = calendar();
const items = cal.months[month] ?? [];
const allMonths = Object.keys(cal.months);
const monthName = new Date(`${month}-01T00:00:00Z`).toLocaleString('en-US', { month: 'long', year: 'numeric', timeZone: 'UTC' });
const platLabel: Record<string, string> = { pc: 'PC', switch: 'Switch', xbox: 'Xbox', psn: 'PlayStation' };
const platforms = ['pc', 'switch', 'xbox', 'psn']
  .filter((platform) => items.some((item: any) => item.platforms?.includes(platform)))
  .map((platform) => platLabel[platform]);
const platformList = platforms.length > 1
  ? `${platforms.slice(0, -1).join(', ')} & ${platforms.at(-1)}`
  : (platforms[0] ?? 'Game');
const initials = (title: string) => title.trim().split(/\s+/).slice(0, 2).map((word) => word[0]).join('').toUpperCase();
const imageFor = (entry: any) => entry.image ?? (entry.slugIfTracked ? gameBundle(entry.slugIfTracked).meta?.headerImage : null);
const primaryUrl = (entry: any) => entry.slugIfTracked ? `/game/${entry.slugIfTracked}` : entry.urls?.[entry.platforms[0]];
---
<Layout
  title={`${platformList} releases — ${monthName} | GamePriceMap`}
  description={`${items.length} ${platformList} releases in ${monthName}, with official store links, artwork and dates.`}
  canonicalPath={canonicalPath}
>
  <div class="page-head wrap">
    <div class="breadcrumb"><a href="/">Home</a><span>/</span>New releases<span>/</span>{monthName}</div>
    <h1>{platformList} releases — {monthName}</h1>
    <p>{items.length} upcoming releases. Dates come from the stores and can shift.</p>
    <div class="chips" style="margin-top: 14px;">
      {allMonths.map((candidate) => (
        <a class:list={['chip', { on: candidate === month }]} href={`/new-releases/${candidate}`}>{candidate}</a>
      ))}
    </div>
  </div>

  <div class="wrap" style="padding-bottom: 24px;">
    <div class="row-list">
      {items.map((entry: any) => {
        const href = primaryUrl(entry);
        const external = href?.startsWith('https://');
        const image = imageFor(entry);
        return (
          <article class="deal-row release-calendar-row">
            <a class="release-row-main" href={href} rel={external ? 'nofollow noopener' : undefined} target={external ? '_blank' : undefined}>
              <div class="thumb release-row-art">
                {image ? <img src={image} alt="" loading="lazy" /> : <span>{initials(entry.title)}</span>}
              </div>
              <div class="info">
                <div class="title">{entry.title}</div>
                <div class="sub">{entry.slugIfTracked ? 'Tracked price page' : 'Official store listing'}</div>
              </div>
            </a>
            <nav class="release-store-links" aria-label={`${entry.title} official store links`}>
              {entry.platforms.map((platform: string) => (
                <a class="release-store-link" href={entry.urls[platform]} rel="nofollow noopener" target="_blank">{platLabel[platform] ?? platform}</a>
              ))}
            </nav>
            <span class="date release-row-date">{entry.date ?? `${entry.month} TBC`}</span>
          </article>
        );
      })}
    </div>
  </div>
</Layout>
