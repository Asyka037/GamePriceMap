---
import { catalog } from '../lib/data.mjs';

interface Props { updatedAt?: string | null }
const { updatedAt = null } = Astro.props;
const stamp = updatedAt ? new Date(updatedAt).toUTCString().replace(':00 GMT', ' UTC') : null;
const games = catalog();
const priceStores = [
  'Steam',
  'Nintendo eShop',
  games.some((game: any) => game.xboxBigId) && 'Xbox',
  games.some((game: any) => game.psnProductId) && 'PlayStation Store',
].filter(Boolean);
const priceStoreLabel = priceStores.length > 1
  ? `${priceStores.slice(0, -1).join(', ')} and ${priceStores.at(-1)}`
  : priceStores[0];
---
<footer class="site-footer">
  <div class="wrap footer-inner">
    <div>
      <div class="logo" style="margin-bottom: 12px;">
        <span class="mark" aria-hidden="true"><img src="/brand/gamepricemap-logo-96.png" alt="" width="96" height="96" loading="lazy" decoding="async" /></span>
        <span class="logo-word">Game<em>PriceMap</em></span>
      </div>
      <p class="footer-note">
        Track verified public purchase prices across {priceStoreLabel}.
        Compare stores and regions, explore price
        history, spot meaningful discounts, and find upcoming releases.
      </p>
    </div>
    <div>
      <h4>Steam</h4>
      <a href="/steam/deals">Deals</a>
      <a href="/steam/regional-pricing">Regional pricing</a>
      <a href="/free-games">PC free games</a>
    </div>
    <div>
      <h4>Nintendo</h4>
      <a href="/switch/deals">Deals</a>
      <a href="/switch/regional-pricing">Regional pricing</a>
    </div>
    <div>
      <h4>Topics</h4>
      <a href="/new-releases">All-platform new releases</a>
      <a href="/free-games">Epic &amp; Steam free games</a>
    </div>
    <div>
      <h4>GamePriceMap</h4>
      <a href="/about">About &amp; data sources</a>
      <a href="/status">Data status</a>
    </div>
  </div>
  <div class="wrap footer-bottom">
    <span>© 2026 GamePriceMap — not affiliated with the tracked stores</span>
    {stamp && <span>Data updated {stamp}</span>}
  </div>
</footer>
